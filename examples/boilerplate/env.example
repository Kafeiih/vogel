APP_ENV=development
APP_PORT=:8080
APP_URL=localhost:8080
APP_VERSION=0.1.0
APP_TIMEOUT=30s

DB_URL=postgres://postgres:postgres@localhost:5433/bluprint_dev?sslmode=disable
DB_MAX_CONNS=25
DB_MIN_CONNS=5
DB_MAX_CONN_LIFETIME=1h
DB_MAX_CONN_IDLE_TIME=30m
DB_CONNECT_TIMEOUT=10s
DB_ACQUIRE_TIMEOUT=3s
DB_LEAK_THRESHOLD=10s
DB_REQUIRE_TLS=false   # solo para el Postgres local, que no sirve TLS

ZITADEL_ISSUER=https://auth.institucion.gob
ZITADEL_CLIENT_ID=your-client-id-here

CERBOS_HOST=localhost:3593
CERBOS_PLAINTEXT=true   # solo para el contenedor local de Cerbos

CORS_ALLOWED_ORIGINS=http://localhost:3000

SWAGGER_ENABLED=true   # UI y spec en /v1/swagger/; solo en desarrollo
# vogel:component bpms begin

# Base BPMS (ver docs/BPMS.md). Gotenberg lo levanta make dev-infra.
GOTENBERG_URL=http://localhost:3000
# GOTENBERG_TIMEOUT=30s
# Los PDF se guardan en el storage BPMS_DOCUMENT_STORAGE (default documents),
# que debe estar en STORAGE_CONFIGS: apunte su endpoint a un S3-compatible.
STORAGE_CONFIGS=documents
STORAGE_DOCUMENTS_BUCKET=documents
# STORAGE_DOCUMENTS_ENDPOINT=http://localhost:9000
# STORAGE_DOCUMENTS_PATH_STYLE=true
# vogel:component bpms end
