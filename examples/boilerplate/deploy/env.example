# Template for deploy/.env (copy it to deploy/.env and fill it in; never
# commit deploy/.env). docker-compose.yaml fails fast when any of the
# required variables below is missing. See RUNBOOK.md section 0.

# Image tag of the api and worker images to deploy (no :latest).
APP_VERSION=

# Superuser password of the bundled Postgres container. Used only by the
# init script in initdb/ on the first start of an empty volume.
POSTGRES_PASSWORD=

# Owner of the schema and tables; used only by the one-shot migrate and
# grants services.
APP_MIGRATOR_PASSWORD=

# Least-privilege role the api and worker connect with (SELECT/INSERT on
# audit_log, no DDL).
APP_RUNTIME_PASSWORD=

# Must stay "development" with the bundled Postgres: it runs without TLS and
# RequireTLS (on outside development) rejects sslmode=disable. In production
# point the DSNs at a TLS-enabled Postgres with sslmode=verify-full and use
# APP_ENV=production.
APP_ENV=development

# River's schema, shared by migrate, api and worker (defaults to river).
# WORKER_SCHEMA=river

# Application settings (Zitadel, Cerbos, storage, notification): same
# variables as the local .env, see the boilerplate README.
# ZITADEL_ISSUER=
# ZITADEL_CLIENT_ID=
# CERBOS_HOST=
# CERBOS_PLAINTEXT=false
