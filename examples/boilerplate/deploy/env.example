# Template for deploy/.env (copy it to deploy/.env and fill it in; never
# commit deploy/.env). docker-compose.yaml fails fast when any of the
# required variables below is missing. See RUNBOOK.md section 0.

# Image tag of the images to deploy (no :latest).
APP_VERSION=

# Password of the "postgres" superuser. The postgres image sets it when it
# initialises an empty volume (initdb/10-roles.sh does not read it); on an
# existing volume changing it here changes nothing, use ALTER ROLE (see
# RUNBOOK.md section 0).
POSTGRES_PASSWORD=

# Owner of the schema and tables; used only by the one-shot migrate and
# grants services.
APP_MIGRATOR_PASSWORD=

# Least-privilege role the serving processes connect with (SELECT/INSERT on
# audit_log, no DDL).
APP_RUNTIME_PASSWORD=

# "development" with this compose; use APP_ENV=production in production.
# It no longer decides TLS to the database: DB_REQUIRE_TLS does, and
# docker-compose.yaml sets it to false for the bundled Postgres only.
APP_ENV=development

# Database pool (optional; must be positive durations, an invalid value
# fails the boot). DB_ACQUIRE_TIMEOUT is how long a request waits for a free
# connection before failing (fail fast when the pool is full); it also bounds
# opening a new connection, so keep it above a healthy connect (the startup
# ping is exempt and waits up to DB_CONNECT_TIMEOUT);
# DB_LEAK_THRESHOLD logs a WARN naming the acquiring code when a connection
# is released after being held longer than this.
# DB_ACQUIRE_TIMEOUT=3s
# DB_LEAK_THRESHOLD=10s

# Swagger UI and spec under /v1/swagger/: off unless this is "true", and
# refused with APP_ENV=production. Leave it unset in a deploy.
# SWAGGER_ENABLED=false

# vogel:component worker begin
# River's schema, shared by migrate, api and worker (defaults to river).
# WORKER_SCHEMA=river
# true: the worker polls for new jobs instead of LISTEN/NOTIFY, so it can
# connect through PgBouncer in transaction mode (jobs may wait up to River's
# 1s FetchPollInterval). Anything but true/false fails the boot.
# WORKER_POLL_ONLY=false

# vogel:component worker end
# Application settings (Zitadel, Cerbos, ...): same variables as the local
# .env, see the README.
# ZITADEL_ISSUER=
# ZITADEL_CLIENT_ID=
# Cerbos PDP: required (docker compose refuses to start without both), and
# always changed as a pair.
# vogel:component cerbos begin
# The bundled PDP (the cerbos service): plaintext, acceptable only on the
# compose's internal authz network. For an external PDP replace this pair
# with the one below and remove the bundled cerbos service (see the comment
# on the api service in docker-compose.yaml).
CERBOS_HOST=cerbos:3593
CERBOS_PLAINTEXT=true
# vogel:component cerbos end
# An external PDP is reached over TLS; never pair an external host with true:
# CERBOS_HOST=pdp.example.internal:3593
# CERBOS_PLAINTEXT=false
# Token validation hardening (defaults in parentheses), see the README:
# ZITADEL_MAX_TOKEN_LIFETIME=12h
# ZITADEL_ALLOWED_AUTHORIZED_PARTIES=
# ZITADEL_INTROSPECTION=false
# ZITADEL_INTROSPECTION_KEY_FILE=
# ZITADEL_INTROSPECTION_CLIENT_SECRET=
