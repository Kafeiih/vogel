# Copy to deploy/.env on each host (one host per environment) and never commit it.

# --- Release
APP_VERSION=
APP_ENV=production
APP_URL=api.institucion.gob
# API_PORT=8080
# APP_TIMEOUT=30s
# METRICS_LISTEN_ADDR=:9090

# --- Database (RDS): the compose builds both DSNs with sslmode=verify-full and the CA bundle (see RUNBOOK.md section 0)
DB_HOST=
DB_NAME=boilerplate_db
APP_MIGRATOR_PASSWORD=
APP_RUNTIME_PASSWORD=
# DB_PORT=5432
# DB_SSLMODE=verify-full
# RDS_CA_BUNDLE=./rds-global-bundle.pem
# DB_MAX_CONNS=25
# DB_MIN_CONNS=5
# DB_MAX_CONN_LIFETIME=1h
# DB_MAX_CONN_IDLE_TIME=30m
# DB_CONNECT_TIMEOUT=10s
# DB_ACQUIRE_TIMEOUT=3s
# DB_LEAK_THRESHOLD=10s

# --- Database (bundled Postgres, non-production hosts only): uncomment and use these instead
# COMPOSE_PROFILES=bundled-db
# DB_HOST=postgres
# DB_SSLMODE=disable
# DB_REQUIRE_TLS=false
# POSTGRES_PASSWORD=

# --- HTTP
CORS_ALLOWED_ORIGINS=https://app.institucion.gob
# Your reverse proxy's CIDRs; empty means the client IP is the socket peer for logs and rate limiting.
TRUSTED_PROXIES=
# SWAGGER_ENABLED=false

# --- Zitadel
ZITADEL_ISSUER=https://auth.institucion.gob
ZITADEL_CLIENT_ID=
# ZITADEL_HTTP_TIMEOUT=10s
# ZITADEL_MAX_TOKEN_LIFETIME=12h
# ZITADEL_ALLOWED_AUTHORIZED_PARTIES=
# ZITADEL_INTROSPECTION=false
# ZITADEL_INTROSPECTION_KEY_FILE=
# ZITADEL_INTROSPECTION_CLIENT_SECRET=
# ZITADEL_INTROSPECTION_CACHE_TTL=30s
# ZITADEL_INTROSPECTION_CACHE_MAX_ENTRIES=10000

# --- Cerbos
# vogel:component cerbos begin
CERBOS_HOST=cerbos:3593
CERBOS_PLAINTEXT=true
# vogel:component cerbos end
# An external PDP is reached over TLS; never pair an external host with CERBOS_PLAINTEXT=true.
# CERBOS_HOST=pdp.example.internal:3593
# CERBOS_PLAINTEXT=false
# vogel:component worker begin

# --- Worker
# WORKER_SCHEMA=river
# WORKER_DEFAULT_MAX_WORKERS=100
# WORKER_QUEUES=default:10
# WORKER_POLL_ONLY=false
# WORKER_METRICS_LISTEN_ADDR=:9091
# vogel:component worker end
# vogel:component notification begin

# --- Notifications
# NOTIFICATION_PROVIDER=smtp
# NOTIFICATION_DEFAULT_FROM=
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SENDGRID_API_KEY=
# vogel:component notification end
# vogel:component storage begin

# --- Storage (S3): STORAGE_CONFIGS lists every storage, comma-separated (e.g. private)
# vogel:component bpms begin
STORAGE_CONFIGS=documents
STORAGE_DOCUMENTS_BUCKET=
# STORAGE_DOCUMENTS_REGION=us-east-1
# STORAGE_DOCUMENTS_ENDPOINT=
# vogel:component bpms end
# STORAGE_PRIVATE_BUCKET=
# STORAGE_PRIVATE_REGION=us-east-1
# STORAGE_PRIVATE_ENDPOINT=
# STORAGE_PRIVATE_ACCESS_KEY=
# STORAGE_PRIVATE_SECRET_KEY=
# STORAGE_PRIVATE_PATH_STYLE=false
# STORAGE_PRIVATE_PRESIGN_EXPIRY=15m
# vogel:component storage end
# vogel:component bpms begin

# --- BPMS (docs/BPMS.md): Gotenberg renders the PDFs into BPMS_DOCUMENT_STORAGE, which must be listed in STORAGE_CONFIGS
GOTENBERG_URL=http://gotenberg:3000
# GOTENBERG_TIMEOUT=30s
# BPMS_DOCUMENT_STORAGE=documents
# vogel:component bpms end
# vogel:component tracing begin

# --- Tracing (off while the endpoint is empty)
# OTEL_EXPORTER_OTLP_ENDPOINT=
# OTEL_SERVICE_NAME=
# OTEL_TRACES_SAMPLER_ARG=0.1
# vogel:component tracing end
