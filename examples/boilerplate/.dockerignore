# Build context filter for a service generated from this boilerplate, where
# this file sits at the repository root and the Dockerfile copies the whole
# context into the builder stage (COPY . /src).
# vogel:only begin
# Inside the vogel repository the context is vogel's root, so its own
# .dockerignore applies instead.
# vogel:only end

# Never send local credentials to the build.
**/.env
**/.env.*
**/*.pem
**/*.key
**/secrets/

# VCS, CI and build outputs.
.git
.github/
bin/
tmp/
coverage*.out

# Not part of the binaries: deploy files, the Cerbos bundle (its own build
# context), Markdown and the Dockerfile itself. api/ stays: the binary embeds
# api/openapi.yaml.
deploy/
# vogel:component cerbos begin
cerbos/
# vogel:component cerbos end
**/*.md
Dockerfile
.dockerignore
