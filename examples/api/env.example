# PostgreSQL connection string used by this example's own migrations, the
# audit and workflow migration sets, and the River job queue.
#
# Port 55432 is the host-side mapping in docker-compose.yaml, chosen so this
# example never collides with a PostgreSQL already listening on 5432.
DATABASE_URL=postgres://vogel_example:vogel_example@localhost:55432/vogel_example?sslmode=disable

# HTTP port this example listens on.
PORT=8080

# One of: development, staging, production. Controls log level and format
# (see logger.New) and is validated at boot via config.Errors.OneOf.
ENV=development

# PostgreSQL schema River's tables live in. Must be a valid, unquoted
# identifier; there is no library default on purpose (see worker.Config).
RIVER_SCHEMA=river

# Default "From" address for outbound notifications.
NOTIFY_FROM=noreply@example.com

# Maximum time graceful shutdown waits for in-flight requests and jobs to
# finish before the process exits anyway.
SHUTDOWN_TIMEOUT=15s

# Address of the internal listener that serves /metrics (Prometheus), apart
# from PORT. The loopback default keeps it off the network; inside a
# container scraped from another host use ":2112" and do not publish it.
# (2112, not 9090: 9090 is Prometheus's own default port.)
METRICS_ADDR=127.0.0.1:2112

# HTTP server timeouts. Each must be positive; a zero or negative value
# stops the app at startup.
HTTP_READ_HEADER_TIMEOUT=5s
HTTP_READ_TIMEOUT=15s
HTTP_WRITE_TIMEOUT=30s
HTTP_IDLE_TIMEOUT=60s

# Per-client-IP rate limit on /api/v1 (sample, per process: each replica
# counts separately, and behind a proxy every client shares its IP).
RATE_LIMIT_REQUESTS=300
RATE_LIMIT_WINDOW=1m

# Origin the fake object store's presigned URLs point at (see fakes.go and
# fakestorage.go): where a client reaches this server's /fake-storage/
# endpoint. Defaults to http://localhost:<PORT>. Not needed with a real
# bucket (storage/s3), whose presigned URLs point at the bucket itself.
# FAKE_STORAGE_BASE_URL=http://localhost:8080
