# PostgreSQL connection string used by this example's own migrations, the
# audit and workflow migration sets, and the River job queue.
#
# Port 55432 is the host-side mapping in docker-compose.yaml, chosen so this
# example never collides with a PostgreSQL already listening on 5432.
DATABASE_URL=postgres://vogel_example:vogel_example@localhost:55432/vogel_example?sslmode=disable

# HTTP port this example listens on.
PORT=8080

# One of: development, staging, production. Controls log level and format
# (see logger.New) and is validated at boot via config.Errors.OneOf.
ENV=development

# PostgreSQL schema River's tables live in. Must be a valid, unquoted
# identifier; there is no library default on purpose (see worker.Config).
RIVER_SCHEMA=river

# Default "From" address for outbound notifications.
NOTIFY_FROM=noreply@example.com

# Maximum time graceful shutdown waits for in-flight requests and jobs to
# finish before the process exits anyway.
SHUTDOWN_TIMEOUT=15s
